"""
OpenESI Screen - Versione migliorata
Ispirato ai concetti moderni ma implementazione originale
Mantiene compatibilità con codice ESI esistente
"""

from enigma import eTimer

class ESIScreen:
    """
    Classe Screen migliorata per OpenESI
    Combina la semplicità ESI con concetti moderni
    """
    
    def __init__(self, session, parent=None):
        # Manteniamo compatibilità con codice esistente
        self.session = session
        self.parent = parent
        
        # Nuove feature ispirate a concetti moderni
        self.onShow = []
        self.onHide = []
        self.onClose = []
        self._isActive = False
        self._focusStack = []
        
        # Timer per gestione eventi
        self.closeTimer = eTimer()
        self.closeTimer_conn = None
        
        # Gestione componenti migliorata
        self.components = {}
        self.renderer = {}
        
    def show(self):
        """Mostra lo schermo - versione migliorata"""
        if not self._isActive:
            self._isActive = True
            for callback in self.onShow:
                callback()
            self.execBegin()
            
    def hide(self):
        """Nascondi lo schermo - versione migliorata"""
        if self._isActive:
            self._isActive = False
            for callback in self.onHide:
                callback()
            self.execEnd()
            
    def close(self, result=None):
        """Chiudi lo schermo - gestione migliorata"""
        self.hide()
        for callback in self.onClose:
            callback(result)
            
    def setFocus(self, component):
        """Gestione focus migliorata"""
        if self._focusStack and self._focusStack[-1] == component:
            return
            
        if component in self._focusStack:
            self._focusStack.remove(component)
            
        self._focusStack.append(component)
        
    def getFocus(self):
        """Ottieni componente focalizzato"""
        if self._focusStack:
            return self._focusStack[-1]
        return None
        
    def execBegin(self):
        """Eseguito quando lo schermo diventa attivo"""
        pass
        
    def execEnd(self):
        """Eseguito quando lo schermo diventa inattivo"""
        pass

# Classe di compatibilità per codice esistente
Screen = ESIScreen
