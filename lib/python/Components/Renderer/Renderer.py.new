"""
OpenESI Renderer - Sistema Rendering Modernizzato
Renderer ad alte prestazioni con cache e ottimizzazioni
"""

from enigma import eCanvas, eSize, ePoint, eRect, gRGB, gFont
from Components.GUIComponent import GUIComponent
import time

class RendererContext:
    """Contesto di rendering per gestione stato e cache"""
    
    def __init__(self):
        self.cache = {}
        self.dirty_regions = []
        self.last_render_time = 0
        self.frame_count = 0
        self.performance_stats = {}
        
    def markDirty(self, rect):
        """Marca una regione come sporca per il rendering"""
        self.dirty_regions.append(rect)
        
    def clearDirty(self):
        """Pulisce le regioni sporche"""
        self.dirty_regions = []
        
    def getDirtyRegions(self):
        """Ottiene le regioni che necessitano rendering"""
        return self.dirty_regions

class Renderer(GUIComponent):
    """
    Classe base Renderer migliorata con cache e ottimizzazioni
    """
    
    def __init__(self):
        GUIComponent.__init__(self)
        self.render_context = RendererContext()
        self._content = None
        self._cached_content = None
        self._needs_redraw = True
        self._last_update = 0
        self._update_interval = 0  # 0 = sempre, >0 = intervallo in ms
        
        # Ottimizzazioni performance
        self._visibility_check = True
        self._lazy_rendering = True
        
    def createInstance(self, parent):
        """Crea l'istanza di rendering"""
        return eCanvas(parent)
        
    def setContent(self, content):
        """Imposta il contenuto con controllo cambiamenti"""
        if self._cached_content != content:
            self._cached_content = content
            self._content = content
            self._needs_redraw = True
            self.invalidate()
            
    def getContent(self):
        """Ottiene il contenuto corrente"""
        return self._content
        
    def setUpdateInterval(self, interval_ms):
        """Imposta intervallo di aggiornamento per ridurre CPU"""
        self._update_interval = interval_ms
        
    def updateContent(self, content):
        """Aggiorna il contenuto con controllo intervallo"""
        current_time = time.time() * 1000  # ms
        if (self._update_interval == 0 or 
            current_time - self._last_update >= self._update_interval):
            self.setContent(content)
            self._last_update = current_time
            
    def invalidate(self, rect=None):
        """Marca il renderer come da ridisegnare"""
        self._needs_redraw = True
        if self.instance:
            if rect:
                self.instance.invalidate(rect)
            else:
                self.instance.invalidate()
                
    def applySkin(self, desktop, parent):
        """Applica le proprietà skin con ottimizzazioni"""
        self._needs_redraw = True
        return GUIComponent.applySkin(self, desktop, parent)
        
    def suspendRendering(self):
        """Sospende temporaneamente il rendering"""
        self._visibility_check = False
        
    def resumeRendering(self):
        """Riprende il rendering"""
        self._visibility_check = True
        self._needs_redraw = True
        self.invalidate()
        
    def calculateSize(self):
        """Calcola dimensione ottimale per il rendering"""
        if self.instance:
            return self.instance.size()
        return eSize(0, 0)
        
    def onShow(self):
        """Callback quando il renderer viene mostrato"""
        self.resumeRendering()
        
    def onHide(self):
        """Callback quando il renderer viene nascosto"""
        self.suspendRendering()

class AcceleratedRenderer(Renderer):
    """Renderer accelerato per contenuti complessi"""
    
    def __init__(self):
        Renderer.__init__(self)
        self._hardware_accelerated = True
        self._texture_cache = {}
        self._shader_programs = {}
        
    def preloadTextures(self, texture_list):
        """Precarica texture per rendering più fluido"""
        for tex_name, tex_data in texture_list:
            if tex_name not in self._texture_cache:
                self._texture_cache[tex_name] = self._createTexture(tex_data)
                
    def _createTexture(self, texture_data):
        """Crea una texture (da implementare per specifico backend)"""
        # Placeholder per implementazione specifica
        return f"texture_{hash(str(texture_data))}"
        
    def clearTextureCache(self):
        """Pulisce la cache texture"""
        self._texture_cache = {}

class CachedRenderer(Renderer):
    """Renderer con cache avanzata per contenuti statici"""
    
    def __init__(self):
        Renderer.__init__(self)
        self._cache_enabled = True
        self._cache_ttl = 5000  # 5 secondi
        self._render_cache = {}
        
    def getCachedRender(self, content_key):
        """Ottiene rendering dalla cache"""
        if not self._cache_enabled:
            return None
            
        cache_entry = self._render_cache.get(content_key)
        if cache_entry and time.time() - cache_entry['timestamp'] < self._cache_ttl:
            return cache_entry['data']
        return None
        
    def setCachedRender(self, content_key, render_data):
        """Salva rendering in cache"""
        if self._cache_enabled:
            self._render_cache[content_key] = {
                'data': render_data,
                'timestamp': time.time()
            }
            
    def clearCache(self):
        """Pulisce la cache"""
        self._render_cache = {}

class CompositeRenderer(Renderer):
    """Renderer per composizione di multiple sorgenti"""
    
    def __init__(self):
        Renderer.__init__(self)
        self._sources = []
        self._blend_modes = {}
        self._z_order = []
        
    def addSource(self, source, z_index=0, blend_mode="normal"):
        """Aggiunge una sorgente di rendering"""
        self._sources.append(source)
        self._blend_modes[source] = blend_mode
        self._z_order.append((z_index, source))
        self._z_order.sort(key=lambda x: x[0])
        self._needs_redraw = True
        
    def removeSource(self, source):
        """Rimuove una sorgente di rendering"""
        if source in self._sources:
            self._sources.remove(source)
            if source in self._blend_modes:
                del self._blend_modes[source]
            self._z_order = [(z, s) for z, s in self._z_order if s != source]
            self._needs_redraw = True
            
    def setBlendMode(self, source, blend_mode):
        """Imposta modalità blend per una sorgente"""
        if source in self._sources:
            self._blend_modes[source] = blend_mode
            self._needs_redraw = True

# Istanza globale per gestione rendering
class RenderManager:
    _instance = None
    
    @classmethod
    def getInstance(cls):
        if cls._instance is None:
            cls._instance = RenderManager()
        return cls._instance
        
    def __init__(self):
        self.renderers = []
        self.frame_time = 0
        self.max_frame_time = 33  # ~30 FPS
        
    def registerRenderer(self, renderer):
        """Registra un renderer per gestione centralizzata"""
        if renderer not in self.renderers:
            self.renderers.append(renderer)
            
    def unregisterRenderer(self, renderer):
        """Rimuove un renderer"""
        if renderer in self.renderers:
            self.renderers.remove(renderer)

# Funzioni helper per compatibilità
def getRendererManager():
    return RenderManager.getInstance()
