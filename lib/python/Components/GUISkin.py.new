"""
OpenESI GUISkin - Sistema Skin Modernizzato
Parser skin avanzato con cache e prestazioni migliorate
Compatibile con skin ESI esistenti
"""

import xml.etree.ElementTree as ET
from os.path import exists, getmtime
import time

class SkinContext:
    """Contesto skin per gestione stati e cache"""
    
    def __init__(self):
        self.variables = {}
        self.colors = {}
        self.fonts = {}
        self.templates = {}
        self.cache = {}
        self.resolution = (720, 576)  # Default SD
        
    def setVariable(self, name, value):
        self.variables[name] = value
        
    def getVariable(self, name, default=None):
        return self.variables.get(name, default)
        
    def setResolution(self, width, height):
        self.resolution = (width, height)
        
    def getResolution(self):
        return self.resolution

class GUISkinParser:
    """
    Parser skin avanzato con cache e prestazioni migliorate
    """
    
    def __init__(self):
        self.skinContext = SkinContext()
        self.skinFiles = {}
        self.lastModified = {}
        self.colorCache = {}
        self.fontCache = {}
        
    def parseSkin(self, skin_file):
        """Parsa un file skin con caching"""
        if not exists(skin_file):
            return None
            
        # Controllo cache e modifiche
        current_mtime = getmtime(skin_file)
        if (skin_file in self.skinFiles and 
            skin_file in self.lastModified and
            self.lastModified[skin_file] == current_mtime):
            return self.skinFiles[skin_file]
            
        try:
            tree = ET.parse(skin_file)
            root = tree.getroot()
            
            # Aggiorna cache
            self.skinFiles[skin_file] = root
            self.lastModified[skin_file] = current_mtime
            
            # Processa elementi base
            self._processColors(root)
            self._processFonts(root)
            self._processTemplates(root)
            
            return root
            
        except Exception as e:
            print(f"[-] Errore parsing skin {skin_file}: {e}")
            return None
            
    def _processColors(self, root):
        """Processa definizioni colori"""
        for color_elem in root.findall(".//color"):
            name = color_elem.get("name")
            value = color_elem.get("value")
            if name and value:
                self.skinContext.colors[name] = self._parseColor(value)
                self.colorCache[name] = self.skinContext.colors[name]
                
    def _processFonts(self, root):
        """Processa definizioni fonts"""
        for font_elem in root.findall(".//font"):
            name = font_elem.get("name")
            filename = font_elem.get("filename")
            scale = font_elem.get("scale", "1.0")
            if name and filename:
                self.skinContext.fonts[name] = {
                    'filename': filename,
                    'scale': float(scale)
                }
                self.fontCache[name] = self.skinContext.fonts[name]
                
    def _processTemplates(self, root):
        """Processa templates skin"""
        for template_elem in root.findall(".//template"):
            name = template_elem.get("name")
            if name:
                self.skinContext.templates[name] = template_elem
                
    def _parseColor(self, color_str):
        """Parser colori avanzato con supporto formati multipli"""
        if color_str.startswith("#"):
            # Formato esadecimale #RRGGBB o #RGB
            color_str = color_str[1:]
            if len(color_str) == 3:
                # Espandi #RGB a #RRGGBB
                color_str = ''.join([c*2 for c in color_str])
            return int(color_str, 16)
        elif color_str.startswith("0x"):
            # Formato 0xRRGGBB
            return int(color_str[2:], 16)
        else:
            # Nome colore predefinito o fallback
            return self._getDefaultColor(color_str)
            
    def _getDefaultColor(self, color_name):
        """Colori predefiniti"""
        default_colors = {
            "black": 0x000000,
            "white": 0xFFFFFF,
            "red": 0xFF0000,
            "green": 0x00FF00,
            "blue": 0x0000FF,
            "yellow": 0xFFFF00,
            "transparent": 0x000000  # Con alpha gestito separatamente
        }
        return default_colors.get(color_name.lower(), 0xFFFFFF)
        
    def getColor(self, color_name):
        """Ottiene colore dalla cache"""
        return self.colorCache.get(color_name, 0xFFFFFF)
        
    def getFont(self, font_name):
        """Ottiene font dalla cache"""
        return self.fontCache.get(font_name)
        
    def applyTemplate(self, widget_elem, template_name):
        """Applica template a un widget"""
        template = self.skinContext.templates.get(template_name)
        if template:
            # Clona il template e applica al widget
            for child in template:
                widget_elem.append(child)
                
    def scaleValue(self, value, reference="width"):
        """Scala valori in base alla risoluzione"""
        if isinstance(value, str) and value.endswith("%"):
            # Valore percentuale
            percent = float(value[:-1]) / 100.0
            if reference == "width":
                return int(self.skinContext.resolution[0] * percent)
            else:
                return int(self.skinContext.resolution[1] * percent)
        else:
            # Valore assoluto
            return int(value)

class SkinManager:
    """Manager centrale per gestione skin"""
    
    _instance = None
    
    @classmethod
    def getInstance(cls):
        if cls._instance is None:
            cls._instance = SkinManager()
        return cls._instance
        
    def __init__(self):
        self.parser = GUISkinParser()
        self.currentSkin = None
        self.skinPath = "/usr/share/enigma2/"
        
    def loadSkin(self, skin_name):
        """Carica uno skin specifico"""
        skin_file = f"{self.skinPath}{skin_name}/skin.xml"
        if exists(skin_file):
            self.currentSkin = self.parser.parseSkin(skin_file)
            return True
        return False
        
    def getCurrentSkin(self):
        return self.currentSkin
        
    def getParser(self):
        return self.parser

# Istanza globale per compatibilità
skin_manager = SkinManager.getInstance()

# Funzioni di compatibilità per codice esistente
def loadSkin(skin_file):
    return skin_manager.parser.parseSkin(skin_file)

def getSkinFactor():
    return 1.0  # Per compatibilità
