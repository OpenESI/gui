"""
OpenESI Converter - Sistema Conversione Dati Modernizzato
Converter ottimizzati con cache e gestione efficiente
"""

import time
import threading
from Tools.Directories import fileExists
from Components.Element import Element

class ConverterContext:
    """Contesto per gestione stato e cache converter"""
    
    def __init__(self):
        self.cache = {}
        self.cache_ttl = 30000  # 30 secondi
        self.stats = {
            'hits': 0,
            'misses': 0,
            'computations': 0
        }
        
    def getCached(self, key):
        """Ottiene valore dalla cache"""
        if key in self.cache:
            entry = self.cache[key]
            if time.time() - entry['timestamp'] < self.cache_ttl:
                self.stats['hits'] += 1
                return entry['value']
        self.stats['misses'] += 1
        return None
        
    def setCached(self, key, value):
        """Salva valore in cache"""
        self.cache[key] = {
            'value': value,
            'timestamp': time.time()
        }
        
    def clearCache(self):
        """Pulisce la cache"""
        self.cache = {}

class Converter(Element):
    """
    Classe base Converter migliorata con cache e ottimizzazioni
    """
    
    def __init__(self, *args, **kwargs):
        Element.__init__(self)
        self.converter_context = ConverterContext()
        self._last_source = None
        self._last_result = None
        self._update_interval = 0
        self._last_update = 0
        self._cached_key = None
        self._async_enabled = False
        
        # Parametri specifici converter
        self.args = args
        self.kwargs = kwargs
        
    def changed(self, what):
        """Metodo changed ottimizzato con cache"""
        current_time = time.time() * 1000
        
        # Controllo intervallo di aggiornamento
        if (self._update_interval > 0 and 
            current_time - self._last_update < self._update_interval):
            return
            
        self._last_update = current_time
        
        # Genera chiave cache
        cache_key = self._generateCacheKey(what)
        
        # Controlla cache
        cached_result = self.converter_context.getCached(cache_key)
        if cached_result is not None:
            self._last_result = cached_result
            self.downstream_elements.changed(what)
            return
            
        # Calcola nuovo risultato
        result = self.doConvert(what)
        self.converter_context.setCached(cache_key, result)
        self._last_result = result
        self._cached_key = cache_key
        
        self.downstream_elements.changed(what)
        self.converter_context.stats['computations'] += 1
        
    def doConvert(self, what):
        """
        Metodo astratto per conversione - da implementare
        nelle sottoclassi specifiche
        """
        return None
        
    def _generateCacheKey(self, what):
        """Genera chiave univoca per cache"""
        source_state = str(getattr(self.source, 'value', '')) if self.source else ''
        return f"{self.__class__.__name__}:{what}:{source_state}:{hash(str(self.args))}"
        
    def setUpdateInterval(self, interval_ms):
        """Imposta intervallo di aggiornamento"""
        self._update_interval = interval_ms
        
    def enableAsync(self, enabled=True):
        """Abilita elaborazione asincrona"""
        self._async_enabled = enabled
        
    def getStats(self):
        """Ottiene statistiche prestazioni"""
        return self.converter_context.stats
        
    def clearConverterCache(self):
        """Pulisce cache specifica del converter"""
        self.converter_context.clearCache()
        self._last_result = None
        self._cached_key = None
        
    def getResult(self):
        """Ottiene l'ultimo risultato calcolato"""
        return self._last_result

class CachedConverter(Converter):
    """Converter con cache avanzata per dati semi-statici"""
    
    def __init__(self, *args, **kwargs):
        Converter.__init__(self, *args, **kwargs)
        self.cache_ttl = kwargs.get('cache_ttl', 60000)  # 1 minuto default
        self.converter_context.cache_ttl = self.cache_ttl
        
    def doConvert(self, what):
        """Implementazione con cache specifica"""
        # Da implementare nelle sottoclassi
        pass

class AsyncConverter(Converter):
    """Converter con elaborazione asincrona"""
    
    def __init__(self, *args, **kwargs):
        Converter.__init__(self, *args, **kwargs)
        self._async_result = None
        self._async_lock = threading.Lock()
        self._async_thread = None
        
    def changed(self, what):
        """Changed con supporto asincrono"""
        if self._async_enabled and self._async_thread is None:
            self._startAsyncConversion(what)
        else:
            Converter.changed(self, what)
            
    def _startAsyncConversion(self, what):
        """Avvia conversione asincrona"""
        def async_convert():
            result = self.doConvert(what)
            with self._async_lock:
                self._async_result = result
                self._async_thread = None
            # Trigger update quando pronto
            self.downstream_elements.changed(what)
            
        self._async_thread = threading.Thread(target=async_convert)
        self._async_thread.daemon = True
        self._async_thread.start()
        
    def doConvert(self, what):
        """Override per elaborazione pesante"""
        # Da implementare nelle sottoclassi
        pass

class CompositeConverter(Converter):
    """Converter che combina multiple conversioni"""
    
    def __init__(self, *args, **kwargs):
        Converter.__init__(self, *args, **kwargs)
        self.converters = []
        self.converter_chain = []
        
    def addConverter(self, converter, position=None):
        """Aggiunge un converter alla catena"""
        if position is None:
            self.converters.append(converter)
        else:
            self.converters.insert(position, converter)
        self._rebuildChain()
        
    def removeConverter(self, converter):
        """Rimuove un converter"""
        if converter in self.converters:
            self.converters.remove(converter)
            self._rebuildChain()
            
    def _rebuildChain(self):
        """Ricostruisce la catena di conversione"""
        self.converter_chain = []
        for converter in self.converters:
            if hasattr(converter, 'getConverterChain'):
                self.converter_chain.extend(converter.getConverterChain())
            else:
                self.converter_chain.append(converter)
                
    def doConvert(self, what):
        """Esegue conversione attraverso la catena"""
        result = self.source.value if self.source else None
        for converter in self.converter_chain:
            if hasattr(converter, 'convert'):
                result = converter.convert(result)
            elif callable(converter):
                result = converter(result)
        return result

# Manager centrale per gestione converter
class ConverterManager:
    _instance = None
    
    @classmethod
    def getInstance(cls):
        if cls._instance is None:
            cls._instance = ConverterManager()
        return cls._instance
        
    def __init__(self):
        self.registered_converters = {}
        self.converter_cache = {}
        
    def registerConverter(self, name, converter_class):
        """Registra un converter per uso dinamico"""
        self.registered_converters[name] = converter_class
        
    def getConverter(self, name, *args, **kwargs):
        """Ottiene un'istanza converter"""
        converter_key = f"{name}:{args}:{kwargs}"
        if converter_key in self.converter_cache:
            return self.converter_cache[converter_key]
            
        converter_class = self.registered_converters.get(name)
        if converter_class:
            converter = converter_class(*args, **kwargs)
            self.converter_cache[converter_key] = converter
            return converter
        return None
        
    def clearConverterCache(self):
        """Pulisce cache converter"""
        self.converter_cache = {}

# Istanza globale
converter_manager = ConverterManager.getInstance()
